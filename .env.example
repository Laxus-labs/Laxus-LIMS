# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres is required — there is no SQLite fallback (see config/settings.py).
DB_NAME=lims_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seconds an unconsumed stock reservation is held before it can be swept.
RESERVATION_TTL_SECONDS=900
